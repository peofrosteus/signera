# Signera – Apache-konfiguration (one.com)
Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Tvinga HTTPS
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !=https
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Blockera allt utom assets/ och index.php
    RewriteRule ^(config|src|storage|templates|migrations|bin|vendor)(/|$) - [F,L]
    RewriteRule (^|/)\.(?!well-known) - [F,L]
    RewriteRule \.(sql|md|lock|json|dist|example|log)$ - [F,L]

    # Statiska filer serveras direkt, allt annat går till index.php
    RewriteCond %{REQUEST_URI} !^/assets/
    RewriteRule ^ index.php [L,QSA]
</IfModule>

<IfModule mod_php.c>
    php_value upload_max_filesize 25M
    php_value post_max_size 30M
</IfModule>
